# Build-time (Vite — baked into the JS bundle at build time)
VITE_SITE_NAME=arzan.kz
VITE_SITE_URL=https://arzan.kz
VITE_SITE_LANG=kk
VITE_SITE_TAGLINE=выгодные цены на продукты в Казахстане
VITE_SITE_DESCRIPTION=arzan.kz помогает сравнивать цены на продукты питания в Алматы, Астане, Шымкенте и Караганде и находить выгодные предложения среди популярных магазинов.
VITE_TWITTER_HANDLE=@arzankz
VITE_OG_LOCALE=kk_KZ
VITE_OG_LOCALE_ALT=ru_KZ
VITE_API_BASE_URL=https://backend.minprice.kz/api
VITE_AUTH_BASE_URL=https://backend.minprice.kz/api
VITE_TELEGRAM_BOT_USERNAME=ArzanLoginBot

# Runtime (server.js — read at Node.js startup, not baked into bundle)
SITE_URL=https://arzan.kz
SITE_NAME=arzan.kz
SITE_LANG=kk
ALTERNATE_SITE_URL=https://minprice.kz
ALTERNATE_SITE_LANG=ru
API_BASE_URL=https://backend.minprice.kz/api
PORT=3000

